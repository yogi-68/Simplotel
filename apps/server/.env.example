# ---------------------------------------------------------------------------
# Server configuration. Copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored — never commit a real key.
# ---------------------------------------------------------------------------

# Which AI provider backs the assistant.
#   mock    — deterministic, offline, no key needed. Default; all tests use it.
#   openai  — real LLM. Requires OPENAI_API_KEY.
#   failing — always throws. Used to demo/verify the degraded fallback path.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai
OPENAI_API_KEY=

# Any chat-completions model with tool-calling support.
OPENAI_MODEL=gpt-4o-mini

# How context is assembled for the model.
#   lexical — BM25 retrieval, top-K facts only (default; see EVALUATION.md)
#   full    — the entire knowledge base every turn (A/B baseline)
RETRIEVAL_MODE=lexical

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated CORS allowlist for the browser app.
WEB_ORIGIN=http://localhost:3000

# Resilience knobs
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
